<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="14.0"
      prefHeight="650.0"
      prefWidth="1000.0"
      xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.csc325_firebase_webview_auth.view.LoginController"
      styleClass="splash-root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <children>
        <Label text="Welcome" styleClass="splash-title"/>
        <Label text="Sign in, register, or continue as guest" styleClass="splash-subtitle"/>

        <TextField fx:id="emailField" promptText="Email" maxWidth="300"/>
        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"/>

        <Button text="Sign In" onAction="#handleSignIn" maxWidth="300"/>
        <Button text="Register User" onAction="#handleRegister" maxWidth="300"/>
        <Button text="Continue as Guest" onAction="#handleGuest" maxWidth="300"/>

        <Label fx:id="messageLabel" text=""/>
    </children>
</VBox>