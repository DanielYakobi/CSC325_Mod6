<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      alignment="CENTER"
      prefHeight="650.0"
      prefWidth="1000.0"
      spacing="16.0"
      styleClass="splash-root">

    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <children>
        <Label text="FSC Student Records App" styleClass="splash-title"/>
        <Label text="Loading..." styleClass="splash-subtitle"/>
    </children>
</VBox>